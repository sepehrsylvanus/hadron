# PostgreSQL 18 local development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hadron_erp
POSTGRES_USER=hadron_app
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Private S3-compatible personnel-photo storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=replace-with-local-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-local-minio-secret
MINIO_PROFILE_BUCKET=hadron-profile-photos
MINIO_COLLABORATION_BUCKET=hadron-collaboration-files

# Self-hosted LiveKit for internal voice/video calls
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-a-long-livekit-api-secret
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881

# One-time secret used only while no Identity user exists
IDENTITY_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-bootstrap-token

# Frontend development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:5080/api
# Optional canonical frontend origin for copied guest meeting links. Never use the API origin.
# VITE_PUBLIC_APP_ORIGIN=http://192.168.0.175:5173
