{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "IncludeErrorDetail": false
  },
  "MrpAutomation": {
    "Enabled": true,
    "DebounceSeconds": 4,
    "PollSeconds": 3,
    "LeaseMinutes": 10,
    "MaxAttempts": 3
  }
}
