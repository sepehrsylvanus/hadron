# Copy to deploy/production.env on the Linux host, replace every CHANGE_ME
# value, and restrict it with: chmod 600 deploy/production.env

# Public HTTPS endpoint. DNS must point to this server before first startup.
ERP_SITE_ADDRESS=erp.example.com
ERP_ALLOWED_HOSTS=erp.example.com
ACME_EMAIL=ops@example.com

# Immutable image names/tags are recommended for controlled rollout/rollback.
API_IMAGE=hadron-erp-api:2026.09.0
WEB_IMAGE=hadron-erp-web:2026.09.0

# PostgreSQL (internal Docker network only).
POSTGRES_DB=hadron_erp
POSTGRES_USER=hadron_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

# Private S3-compatible storage (internal Docker network only).
MINIO_ACCESS_KEY=CHANGE_ME_USE_A_RANDOM_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_MINIO_SECRET
MINIO_PROFILE_BUCKET=hadron-profile-photos
MINIO_COLLABORATION_BUCKET=hadron-collaboration-files
MINIO_BACKUP_BUCKETS=hadron-profile-photos,hadron-collaboration-files

# Self-hosted LiveKit. Both DNS names must resolve to this host. The URL is
# returned to browsers; it must use WSS when the ERP is served over HTTPS.
LIVEKIT_SITE_ADDRESS=rtc.example.com
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=CHANGE_ME_USE_A_RANDOM_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_LIVEKIT_API_SECRET
LIVEKIT_NODE_IP=CHANGE_ME_USE_THE_CLIENT_REACHABLE_SERVER_IP
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT_RANGE_START=50000
LIVEKIT_UDP_PORT_RANGE_END=50100

# One-time bootstrap secret. Rotate it after the first administrator exists.
IDENTITY_BOOTSTRAP_TOKEN=CHANGE_ME_USE_A_LONG_ONE_TIME_BOOTSTRAP_TOKEN

# Canonical persistent ASP.NET Core Data Protection location.
DATA_PROTECTION_KEYS_PATH=/home/hadron/.aspnet/DataProtection-Keys

# Used only by the explicit maintenance profile. Backup scripts override this
# with a timestamped absolute directory for each run.
BACKUP_HOST_PATH=./backups/production
